NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# server only, never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_CREW=price_xxx
# optional AI roadmaps: Gemini wins when both are set; both empty = template roadmaps
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# passwords for seed users and for the judge / demo accounts
SEED_PASSWORD=change-me
JUDGE_PASSWORD=change-me
# local Postgres admin URL for `pnpm test:db`
DATABASE_URL=postgres://youruser@localhost:5432/postgres
# prod URL for `pnpm smoke`
SMOKE_URL=https://your-app.vercel.app
# who accepts connect requests by themselves: demo (seeded people, default) | all (testing with friends) | off
AUTO_ACCEPT_CONNECTS=demo
# numeric id of the K7 LinkedIn Company Page: badges added to LinkedIn then show the K7 logo
NEXT_PUBLIC_LINKEDIN_ORG_ID=
