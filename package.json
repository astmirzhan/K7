{
  "name": "k7",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:db": "bash tests/db/run.sh",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=iphone --project=pixel",
    "seed": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "seed:judges": "node --env-file=.env.local --import tsx scripts/seed-judges.ts",
    "smoke": "node --env-file=.env.local --import tsx scripts/smoke.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm test:db && pnpm build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "stripe": "^23.1.0",
    "swr": "^2.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0"
}
